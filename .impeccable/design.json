  "narrative": {
    "northStar": "A quiet working room inside the Najdi circle",
    "overview": "The teacher dashboard belongs to the same deep burgundy Najdi world as the public student site. A muted geometric rug, dark fabric, warm ivory reading, amber actions, Amiri Arabic headings and Lora English headings establish that relationship. A persistent task sidebar and restrained working sheets give private teaching work its own clear organization.\n\nThe dashboard is a calm operating surface for quizzes, grades, Sunday homework and approved funny answers. Actual counts and task rows carry the hierarchy. Keep the Sadu seam at the navigation edge and teacher entry; content receives space, fine rules and quiet tonal separation. There is no ornamental animation in the teacher shell.",
    "keyCharacteristics": [
      "Deep burgundy rug and dark working ground, with warm ivory reading and amber actions.",
      "A persistent logical-start sidebar that becomes a compact sticky menu on mobile.",
      "Clay editing sheets, cream fields and visible save actions.",
      "Equal English and Arabic functionality with mirrored layout and isolated mixed-script numbers.",
      "Real operational counts, clear task rows and restrained Sadu detail."
    ],
    "rules": [
      {
        "name": "The Working Contrast Rule",
        "body": "Dark task surfaces use warm light reading; clay editing sheets use dark reading and burgundy controls. Preserve the local form palette through labels, help, notes, choices and source evidence.",
        "section": "colors"
      },
      {
        "name": "The Two Scripts Rule",
        "body": "Mirror the interface with its language: Amiri for Arabic headings, Lora for English headings and the appropriate sans serif for reading and actions.",
        "section": "typography"
      },
      {
        "name": "The Quiet Dashboard Rule",
        "body": "Keep the private shell still and task-led; use short existing control feedback instead of lantern loops, ornamental motion or ceremonial panels. Reduced motion disables animations, transitions and smooth scrolling.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do carry the public burgundy Najdi palette and Amiri/Lora/script pairing into private work.",
      "Do preserve the sidebar hierarchy and its RTL/mobile equivalents.",
      "Do keep form text, choices and source evidence dark and readable on clay.",
      "Do show actual quiz, draft, submission and homework data.",
      "Do retain 44px targets, labels, focus, skip navigation and reduced motion.",
      "Do preserve explicit save/publish, validation, teacher approval and private controls."
    ],
    "donts": [
      "Don't restore the obsolete cream public shell, Reem Kufi identity, League palette or no-sidebar contract for the teacher dashboard.",
      "Don't add ornamental loops, student hero scenery or decorative data charts to private work.",
      "Don't replace the native Sunday date control with a custom picker.",
      "Don't expose private answer keys or teacher editing controls through student views.",
      "Don't treat older screenshots or invented data as evidence of current production behavior."
    ]
  }
}
