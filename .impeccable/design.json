      "description": "Large selectable answer with letter and animated confirmation.",
      "html": "<label class=\"ds-answer\"><input type=\"radio\" name=\"ds-answer\" checked><span class=\"ds-letter\">A</span><span class=\"ds-answer-copy\" dir=\"auto\">A thoughtful answer</span><span class=\"ds-answer-check\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span></label>",
      "css": ".ds-answer{position:relative;display:flex;align-items:center;gap:15px;min-height:78px;padding:19px;margin:12px 0;border:1px solid #c6d3e6;border-radius:9px;background:var(--white);color:var(--ink);font:400 18px/1.65 Figtree,Arial,sans-serif;cursor:pointer;transition:background .16s,border-color .16s}.ds-answer:hover{background:#edf2fc;border-color:#a1b5d6}.ds-answer>input{position:absolute;inset:0;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}.ds-answer:focus-within{outline:3px solid var(--focus);outline-offset:4px}.ds-letter{display:grid;place-items:center;width:29px;height:31px;background:#edf1f8;border-radius:6px;color:var(--muted);font-size:13px;font-weight:700;flex-shrink:0}.ds-answer-copy{flex:1;min-width:0;overflow-wrap:anywhere}.ds-answer-check{height:22px;width:22px;display:grid;place-items:center;border-radius:50%;border:1px solid #c8d5e8;flex-shrink:0}.ds-answer-check svg{visibility:hidden}.ds-answer:has(input:checked){border:2px solid var(--blue);background:var(--soft-blue);padding:18px}.ds-answer:has(input:checked) .ds-letter,.ds-answer:has(input:checked) .ds-answer-check{background:var(--blue);color:var(--white);border-color:var(--blue)}.ds-answer:has(input:checked) svg{visibility:visible;animation:ds-check-pop .25s var(--ease)}@keyframes ds-check-pop{from{transform:scale(.65)}to{transform:scale(1)}}@media(max-width:580px){.ds-answer{padding:16px 13px;min-height:76px;gap:11px;font-size:17px}.ds-answer:has(input:checked){padding:15px 12px}.ds-letter{width:26px;height:29px;font-size:12px}.ds-answer-check{width:20px;height:20px}}@media(prefers-reduced-motion:reduce){.ds-answer,.ds-answer svg{animation:none!important;transition:none!important}}",
      "refersTo": "answer-option"
    }
  ],
  "narrative": {
    "northStar": "The Tamkeen League",
    "overview": "A friendly youth tournament expressed through a club crest, clear quiz actions, podiums and teacher team sheets. Royal blue identifies actions and selections; navy contains score displays; yellow marks achievement. Pale paper, flat white surfaces and readable slate text keep the working areas calm.\n\nFigtree carries the interface and Barlow Condensed gives real scores their scoreboard character. Students choose a quiz, answer one question at a time and receive their saved result. Teachers work through visible destinations and choices. Celebration is brief and tied to completion; group standings, grades, answer keys and funny answers stay in the authorized teacher area.",
    "keyCharacteristics": [
      "Four direct teacher destinations and one task per screen.",
      "Visible radio choices and explicit next actions.",
      "Real ranks, shared ties and strong numeric hierarchy.",
      "Brief selection feedback and finite result celebration.",
      "Readable mobile forms and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Earned Score Rule",
        "body": "Use champion color and scoreboard numerals for real scores and ranks; never manufacture progress or public group standings.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Figtree carries reading and actions; Barlow Condensed carries scoreboard numbers.",
        "section": "typography"
      },
      {
        "name": "The Flat Team Sheet Rule",
        "body": "Separate working surfaces with tone, whitespace and fine borders; keep resting surfaces free of shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use royal blue for actions and selections, navy for score stages and yellow for earned achievement.",
      "Do preserve visible task destinations, radio choices and direct actions without dropdowns in the current teacher flows.",
      "Do keep real tied ranks together and keep group grades in the teacher area.",
      "Do retain labels, visible focus, Arabic direction handling, source excerpts and teacher review before AI publication.",
      "Do keep celebration finite and honor reduced-motion preferences."
    ],
    "donts": [
      "Don't add invented progress, attendance, streaks or quiz history.",
      "Don't expose teacher standings, answer keys or funny answers in student views.",
      "Don't reuse scoreboard type for paragraphs or form labels.",
      "Don't add decorative eyebrows or redundant numeric ornaments above task headings.",
      "Don't treat old screenshots as evidence that the current refinement passed visual review."
    ]
  }
