    {
      "name": "Student Quiz Card",
      "kind": "card",
      "description": "A student task with title, instructions and a visible next action.",
      "html": "<article class=\"ds-quiz\"><div><h2>Everyday etiquette</h2><p>Choose one answer for each question.</p><span class=\"ds-quiz-help\">5 questions · no time limit</span></div><button class=\"ds-quiz-start\">Start quiz</button></article>",
      "css": ".ds-quiz{display:flex;align-items:center;justify-content:space-between;gap:30px;background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:28px;font-family:Figtree,Arial,sans-serif;color:var(--ink)}.ds-quiz h2{font-size:23px;font-weight:700;line-height:1.3;letter-spacing:-.025em;margin:0 0 10px}.ds-quiz p{font-size:15px;line-height:1.6;color:var(--muted);max-width:60ch;margin:0 0 15px}.ds-quiz-help{font-size:13px;line-height:1.7;color:var(--muted)}.ds-quiz-start{display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;font:700 15px/1.6 Figtree,Arial,sans-serif;min-height:46px;border-radius:8px;padding:11px 18px;white-space:nowrap;transition:background .16s,border-color .16s,transform .16s var(--ease);min-width:140px;border:1px solid transparent;background:var(--blue);color:var(--white)}.ds-quiz-start:hover:not(:disabled){background:var(--blue-dark)}.ds-quiz-start:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}.ds-quiz-start:not(:disabled):active{transform:scale(.98)}@media(max-width:580px){.ds-quiz{padding:25px;flex-direction:column;align-items:stretch;gap:22px}.ds-quiz p{font-size:14px}.ds-quiz-start{width:100%;font-size:14px;min-height:45px;padding:11px 16px;justify-content:space-between}}@media(prefers-reduced-motion:reduce){.ds-quiz-start{transition:none}}",
      "refersTo": "student-quiz"
    },
    {
      "name": "Quiz Radio Choice",
      "kind": "custom",
      "description": "Visible quiz title and detail with a whole-card focus outline.",
      "html": "<fieldset class=\"ds-quiz-choices\"><legend>Choose a quiz</legend><label class=\"ds-quiz-choice\"><input type=\"radio\" name=\"ds-quiz\" checked><span class=\"ds-quiz-choice-copy\"><b>Original etiquette quiz</b><small>Paper quiz · 13 points + bonus</small></span><span class=\"ds-choice-check\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span></label></fieldset>",
      "css": ".ds-quiz-choices{border:0;padding:0;margin:0;font-family:Figtree,Arial,sans-serif;color:var(--ink)}.ds-quiz-choices legend{font-size:14px;font-weight:600;line-height:1.6;margin-bottom:12px}.ds-quiz-choice{display:flex;align-items:center;gap:12px;background:var(--white);border:1px solid #cbd7e8;border-radius:9px;padding:15px;cursor:pointer;min-width:0}.ds-quiz-choice>input{position:absolute;opacity:0;width:1px;height:1px}.ds-quiz-choice-copy{flex:1;min-width:0}.ds-quiz-choice b{display:block;font-size:14px;line-height:1.6;font-weight:700;overflow-wrap:anywhere}.ds-quiz-choice small{display:block;font-size:12px;line-height:1.6;font-weight:400;color:var(--muted);margin-top:3px}.ds-choice-check{display:grid;place-items:center;width:20px;height:20px;border:1px solid #bdcce2;border-radius:50%;flex-shrink:0}.ds-choice-check svg{visibility:hidden}.ds-quiz-choice:has(input:checked){background:var(--soft-blue);border-color:var(--blue)}.ds-quiz-choice:has(input:checked) .ds-choice-check{background:var(--blue);color:var(--white);border-color:var(--blue)}.ds-quiz-choice:has(input:checked) svg{visibility:visible}.ds-quiz-choice:focus-within{outline:3px solid var(--focus);outline-offset:3px}@media(max-width:580px){.ds-quiz-choice{padding:14px}}",
      "refersTo": "quiz-choice"
    },
    {
