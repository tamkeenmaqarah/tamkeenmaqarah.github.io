      "css": ".ds-status-row{display:flex;gap:10px}.ds-status{display:inline-flex;align-items:center;font:600 12px/1.6 Figtree,Arial,sans-serif;border-radius:4px;padding:2px 7px}.ds-published{background:#e1f0e6;color:#2d6844}.ds-draft{background:#f0e9fc;color:#6b4b92}.ds-closed{background:#e9edf3;color:#57647a}",
