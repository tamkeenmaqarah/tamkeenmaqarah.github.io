      "css": ".ds-field-label{display:block;font:600 15px/1.6 Figtree,Arial,sans-serif;color:var(--ink)}.ds-field{display:block;width:100%;border:1px solid #bdccdf;background:var(--white);color:var(--ink);border-radius:7px;padding:12px 14px;min-height:47px;margin-top:7px;font:400 16px/1.5 Figtree,Arial,sans-serif;caret-color:var(--blue)}.ds-field:hover{border-color:#8fa6c5}.ds-field::placeholder{color:#68788c;opacity:1}.ds-field:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}",
